<?php

/**
 * @file
 * Theme hooks for the cms_starterkit_theme theme.
 */

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function cms_starterkit_theme_preprocess_page(array &$variables): void {
  $variables['steps_to_profit'] = [
    '#type' => 'component',
    '#component' => 'cms_starterkit_theme:steps-to-profit',
    '#props' => [
      'steps' => [
        ['id' => '1', 'heading' => 'Step 1', 'completed' => TRUE, 'href' => '#step-1'],
        ['id' => '2', 'heading' => 'Step 2', 'completed' => FALSE, 'started' => TRUE, 'href' => '#step-2'],
        ['id' => '3', 'heading' => 'Step 3', 'completed' => FALSE, 'href' => '#step-3'],
      ],
    ],
  ];
}
